#!/bin/sh

echo "🔍 Running pre-commit hooks (lint-staged)..."

echo "🔍 Running Gitleaks..."
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged; then
    echo "❌ Gitleaks detected secrets. Please remove them before committing."
    exit 1
  fi
else
  echo "⚠️ Gitleaks not found. Skipping secret detection."
fi

pnpm exec lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Pre-commit checks failed. Please fix the errors before committing."
  exit 1
fi

echo "✅ Pre-commit checks passed!"
